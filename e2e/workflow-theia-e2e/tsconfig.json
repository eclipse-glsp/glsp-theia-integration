{
  "extends": "@eclipse-glsp/ts-config/tsconfig.json",
  "compilerOptions": {
    // `rootDir: "."` keeps the tests/configs split in the output, i.e. `tests/**` -> `lib/tests/**`.
    // The Playwright projects point at `lib/tests`.
    "composite": true,
    "rootDir": ".",
    "outDir": "lib",
    "declarationMap": true
  },
  "include": ["tests", "playwright.config.ts", "./configs/*.ts"],
  "references": [{ "path": "../playwright-theia" }]
}
