{
  "name": "parent",
  "version": "2.9.0-next",
  "private": true,
  "scripts": {
    "browser": "pnpm -C examples/browser-app",
    "change:theia-version": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./configs/change-theia-version.ts",
    "check:all": "pnpm build && pnpm lint && pnpm format:check && pnpm headers:check",
    "check:headers": "glsp checkHeaders . -t lastCommit",
    "check:theia-version": "theia check:theia-version",
    "clean": "pnpm -r run clean && rimraf logs/*.log",
    "compile": "tsc -b",
    "e2e": "pnpm -C e2e/workflow-theia-e2e",
    "electron": "pnpm -C examples/electron-app",
    "fix:all": "pnpm lint:fix && pnpm format && pnpm headers:fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "generate:index": "pnpm -r generate:index && pnpm lint:fix",
    "headers:check": "glsp checkHeaders .",
    "headers:fix": "glsp checkHeaders . --autoFix",
    "preinstall": "npx only-allow pnpm",
    "lint": "oxlint .",
    "lint:ci": "oxlint . --format github",
    "lint:fix": "pnpm lint --fix",
    "publish:latest": "glsp releng publish latest",
    "publish:next": "glsp releng publish next",
    "test:e2e": "pnpm browser build && pnpm e2e test",
    "upgrade:next": "glsp updateNext",
    "watch:browser": "concurrently --kill-others -n tsc,browser -c red,yellow \"tsc -b -w --preserveWatchOutput\" \"pnpm browser watch\"",
    "watch:electron": "concurrently --kill-others -n tsc,browser -c red,yellow \"tsc -b -w --preserveWatchOutput\" \"pnpm electron watch\""
  },
  "devDependencies": {
    "@eclipse-glsp/dev": "2.9.0-next.4",
    "@types/node": "24.x",
    "concurrently": "^8.2.2",
    "eslint": "^10.10.0",
    "eslint-plugin-import-x": "^4.17.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.4.0"
}
